# Supabase project URL, from Project settings, Data API.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (publishable) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key. Server only, used by the seed script and admin operations. Never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Public origin of the deployed site, used for auth redirects and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Render the Discord sign in button. Set true only after adding Discord credentials in Supabase Auth.
NEXT_PUBLIC_AUTH_DISCORD_ENABLED=false
# Render the Google sign in button. Set true only after adding Google credentials in Supabase Auth.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Comma separated auth user uuids that may open /admin/reports.
ADMIN_USER_IDS=
