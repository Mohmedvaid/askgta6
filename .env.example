# Supabase project URL, from Project settings, Data API.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (publishable) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key. Server only, used by the seed script and admin operations. Never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Public origin of the deployed site, used for auth redirects and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Render the Discord sign in button. Set true only after adding Discord credentials in Supabase Auth.
NEXT_PUBLIC_AUTH_DISCORD_ENABLED=false
# Render the Google sign in button. Set true only after adding Google credentials in Supabase Auth.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Search engine indexing. "off" (the default) disallows everything and sends noindex
# on every page. "on" opens up the public feed, level 0 posts, public groups, and
# public profiles only. Inlined at build time, so changing it needs a rebuild.
NEXT_PUBLIC_INDEXING=off
# Cloudflare Turnstile. "true" renders the widget on signup, sign in, and both
# composers, and makes the server verify every token. Off means no widget and no
# verification, so a missing key is a no op rather than a site nobody can join.
NEXT_PUBLIC_TURNSTILE_ENABLED=false
# Turnstile site key. Safe to expose, it is rendered into the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Turnstile secret key. Server only, used to verify a token with Cloudflare.
TURNSTILE_SECRET_KEY=
